{
  "openapi": "3.1.0",
  "info": {
    "title": "PlaniFiKateur — API de consultation",
    "version": "0.1.5",
    "description": "Accès en lecture aux cartes stockées sur le serveur. La clé agent ne permet aucune modification. En développement local sans clés, la lecture est ouverte uniquement sur la machine locale."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/projects": {
      "get": {
        "summary": "Lister les projets",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "ownerSession": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Données consultées.",
