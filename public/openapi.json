  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "PLANIFIKATEUR_READ_TOKEN, clé de lecture dédiée aux agents."
      },
      "ownerSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "planifikateur_session",
        "description": "Session de l’interface propriétaire."
      }
    },
    "schemas": {
      "Project": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "listCount",
          "cardCount"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "emoji": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "listCount": {
            "type": "integer"
          },
          "cardCount": {
            "type": "integer"
          }
        }
      },
      "List": {
        "type": "object",
        "required": [
          "id",
          "name",
          "color",
          "cardCount"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "cardCount": {
            "type": "integer"
          }
        }
      },
      "Card": {
        "type": "object",
        "required": [
          "id",
          "projectId",
          "listId",
          "title",
          "description",
          "status",
          "priority",
          "tags",
          "checklist",
          "comments"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "projectId": {
            "type": "string"
          },
          "projectName": {
            "type": "string"
          },
          "listId": {
            "type": "string"
          },
          "listName": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "ready",
              "progress",
              "clarify",
              "review",
              "done"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "normal",
              "high"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "checklist": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Criterion"
            }
          },
          "comments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Comment"
            }
          }
        }
      },
      "Criterion": {
        "type": "object",
        "required": [
          "id",
          "text",
          "done"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "done": {
            "type": "boolean"
          }
        }
      },
      "Comment": {
        "type": "object",
        "required": [
          "id",
          "author",
          "text",
          "date"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Meta": {
        "type": "object",
        "required": [
          "revision"
        ],
        "properties": {
          "revision": {
            "type": "integer"
          }
        }
      },
      "Pagination": {
        "type": "object",
        "required": [
          "revision",
          "total",
          "limit",
          "offset",
          "nextOffset"
        ],
        "properties": {
          "revision": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "nextOffset": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
