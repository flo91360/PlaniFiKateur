{
  "name": "planifikateur",
  "private": true,
  "version": "0.1.51",
  "type": "module",
  "scripts": {
    "delivery:prepare": "node scripts/delivery.mjs prepare",
    "delivery:check": "node scripts/delivery.mjs check",
    "pretest": "npm run format:check && npm run lint",
    "test": "node --test --test-timeout=60000 tests/*.test.js",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:browser": "npm run export:preview && playwright test",
    "dev": "vite --host 127.0.0.1 --port 3000",
    "start": "node server/index.js",
    "build": "vite build",
    "export:preview": "npm run build && node scripts/export-preview.mjs",
    "preview": "node server/index.js",
    "db:backup": "node scripts/database.mjs backup",
    "db:restore": "node scripts/database.mjs restore",
    "worker": "node worker/index.mjs",
    "worker:once": "node worker/index.mjs --once"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
